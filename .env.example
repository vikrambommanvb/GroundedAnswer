# Calder County Household Support Program RAG Assistant Configuration

# 1. API Mode Configuration (Default)
# To run in API mode, paste your Groq API key below.
# The assistant will use the Groq cloud LLM to generate plain-language answers with validation.
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Offline Fallback Mode Configuration
# To run in Offline mode, simply leave the GROQ_API_KEY blank, comment it out,
# or do not create a .env file. The application will automatically detect the
# absence of the key and run the deterministic local pipeline completely offline.
#
# GROQ_API_KEY=""
